# Optional. Base image tag. Default: intersystems/irishealth-community:2026.3.0AI.126.0), uncomment for Apple silicon
# IRIS_IMAGE=intersystems/irishealth-community-arm64:2026.3.0AI.126.0

# Required. Any OpenAI-compatible provider works.
OPENAI_API_KEY=sk-your-key-here

# Optional. Trailing slash is required: SDK joins the path as a relative URL, so ".../api/v1" without the slash resolves to ".../api/models"..
# OpenRouter:  https://openrouter.ai/api/v1/
# Local Ollama: http://host.docker.internal:11434/v1/
# OPENAI_BASE_URL=https://openrouter.ai/api/v1/

# Optional. Model override
# FHIR_AGENT_MODEL=openai/gpt-5-nano
